# API
EDGE_API_HOST=0.0.0.0
EDGE_API_PORT=8000

# Frontend
EDGE_HOST=0.0.0.0
EDGE_PORT=5500

# CORS só é usado quando frontend e API estão em portas diferentes.
# Em um Cloudflare Tunnel com mesmo hostname, o frontend usa /api e CORS não é necessário.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Opcional
CAMERA_TEST_TIMEOUT=8
CAMERA_IDLE_TIMEOUT=35

# EdgeSecurity - Cloudflare Tunnel
#
# 1) Crie um Named Tunnel no painel Cloudflare.
# 2) Substitua os valores abaixo pelo UUID e pelo caminho do credentials JSON.
# 3) Troque app.seudominio.com pelo hostname que você configurou.
# 4) Valide com: cloudflared tunnel ingress validate
# 5) Execute com: cloudflared tunnel --config config.yml run NOME-DO-TUNNEL
#
# O frontend fica em :5500 e a API/WebSocket em :8000.
# O mesmo hostname é usado para os dois serviços.

tunnel: SEU-TUNNEL-UUID
credentials-file: C:\\Users\\SEU_USUARIO\\.cloudflared\\SEU-TUNNEL-UUID.json

ingress:
  # API REST, health, autenticação, câmeras e MJPEG.
  - hostname: app.seudominio.com
    path: ^/api/.*$
    service: http://127.0.0.1:8000

  # WebSocket usado posteriormente pelo YOLO26 ao vivo.
  - hostname: app.seudominio.com
    path: ^/ws/.*$
    service: http://127.0.0.1:8000

  # Documentação do FastAPI, útil para testes.
  - hostname: app.seudominio.com
    path: ^/(docs|redoc|openapi\.json)$
    service: http://127.0.0.1:8000

  # Todo o restante é o frontend estático.
  - hostname: app.seudominio.com
    service: http://127.0.0.1:5500

  - service: http_status:404

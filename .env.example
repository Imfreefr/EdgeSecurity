# EdgeSecurity Environment Configuration
# Copy to .env and fill in your values

# =============================================
# DATABASE
# =============================================
# SQLite (local development) - default
DB_PATH=backend/edgesecurity.db

# PostgreSQL/Supabase (production)
# Get from Supabase Dashboard > Settings > Database > Connection string > URI
# Format: postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
DATABASE_URL=
# Alternative: SUPABASE_DB_URL (same as DATABASE_URL)
SUPABASE_DB_URL=

# Connection pool settings (PostgreSQL only)
PG_POOL_MIN=2
PG_POOL_MAX=10

# =============================================
# SUPABASE (for future Supabase Auth / Storage integration)
# =============================================
# Get from Supabase Dashboard > Settings > API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# =============================================
# API / CORS
# =============================================
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
EDGE_API_HOST=127.0.0.1
EDGE_API_PORT=8000
EDGE_HOST=127.0.0.1
EDGE_PORT=5500

# =============================================
# SESSION / AUTH
# =============================================
SESSION_IDLE_TIMEOUT=28800
CAMERA_TEST_TIMEOUT=8
SUPER_ADMIN_EMAIL=admin@edgesecurity.com
SUPER_ADMIN_PASSWORD=zrdLzYYIBA0E4KrI
SUPER_ADMIN_NAME=Administrador Master
AUTH_SECRET=
DATA_ENCRYPTION_KEY=
COOKIE_SECURE=false

# =============================================
# SUBSCRIPTION / PAYMENTS
# =============================================
SUBSCRIPTION_VALUE=149.90
PAYMENT_MOCK=true
PAYMENT_WEBHOOK_SECRET=
MP_ACCESS_TOKEN=
MP_PREAPPROVAL_URL=https://api.mercadopago.com/preapproval
MP_BACK_URL=http://localhost:5500/pages/pagamento.html

# =============================================
# AI / MODEL
# =============================================
AI_LOCAL=true
MODEL_PATH=backend/model/edgev1.pt
AI_CONFIDENCE=0.40
AI_IOU=0.50

# =============================================
# SETUP
# =============================================
SETUP_TOKEN=
SETUP_ENABLED=false
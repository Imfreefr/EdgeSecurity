# Caminho para o seu modelo treinado YOLO26 (.pt ou formato suportado)
MODEL_PATH=./model/best.pt

# Banco local para desenvolvimento. Em produção, use PostgreSQL:
# DATABASE_URL=postgresql+psycopg://usuario:senha@host:5432/edgesecurity
DATABASE_URL=sqlite:///./edgesecurity.db

# Chave longa e aleatória para JWT
JWT_SECRET=ALTERE_ESTA_CHAVE_EM_PRODUCAO

# Origem do frontend hospedado
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Parâmetros de análise
AI_CONFIDENCE=0.40
AI_IOU=0.50
AI_FPS=8
